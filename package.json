{
  "name": "xiaodao-mindmap",
  "version": "0.1.1",
  "description": "A Vue 3 component for drawing mindmaps",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vue",
    "mindmap",
    "component"
  ],
  "main": "./dist/xiaodao-mindmap.umd.cjs",
  "module": "./dist/xiaodao-mindmap.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/xiaodao-mindmap.js",
      "require": "./dist/xiaodao-mindmap.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaodaozhi/xiaodao-mindmap.git"
  }
}
